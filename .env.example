# ── Backend ──
GEMINI_API_KEY=
# Check this id against the models your key can use; if a call fails the app falls back
# to its built-in templates, so a wrong id only shows up as "Offline template".
GEMINI_MODEL=gemini-3.8-flash
CORS_ORIGINS=http://localhost:5173

# Auth0 (optional: leave all of these empty to run with no sign-in; saved plans then stay
# in each browser). The two backend values check the login token on /api/plans.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
# Where saved plans are kept (SQLite file). On a host with a disposable disk, point this
# at a mounted volume or saved plans are lost on redeploy.
PLANS_DB=

# ── Frontend (read from this same file by Vite) ──
# Same tenant, plus the Single Page Application's client id. All three are public values,
# not secrets. Never put an Auth0 client secret or any API key here that starts with VITE_.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
