# Gemini writes the urgent appeal and the travel checklist; without a key, templates are used.
GEMINI_API_KEY=
# The trip checklist is built on page load, so it uses a fast model.
GEMINI_BRIEFING_MODEL=gemini-3.5-flash-lite
# Optional: try this model first for appeals (default gemini-3.5-flash, then -lite).
GEMINI_APPEAL_MODEL=
# Postgres for the donor registry (a Tiger Data / Tiger Cloud connection string).
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173

# Auth0 (optional: leave all of these empty to run with no sign-in, as one local charity).
# The two backend values check each request's login token.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# ── Frontend (read from this same file by Vite) ──
# Same tenant, plus the Single Page Application's client id. All three are public values,
# not secrets. Never put an Auth0 client secret or any API key here that starts with VITE_.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
